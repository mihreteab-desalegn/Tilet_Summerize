# OpenRouter AI API Key (required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model selection (optional — defaults to openrouter/auto)
OPENROUTER_MODEL=openrouter/auto

# Server port (optional — defaults to 5000)
PORT=5000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://tilet-summerize.onrender.com

# Public app URL (used in preview route redirects)
APP_URL=https://tilet-summerize.onrender.com
